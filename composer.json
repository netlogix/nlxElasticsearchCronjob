{
    "name": "netlogix/nlxelasticsearchcronjob",
    "description": "This plugin adds elasticsearch cronjobs to synchronize data with the database ",
    "type": "shopware-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "netlogix GmbH & Co. KG",
            "email": "websolutions@netlogix.de"
        }
    ],
    "extra": {
        "installer-name": "nlxElasticsearchCronjob"
    },
    "autoload": {
        "psr-4": {
            "nlxElasticsearchCronjob\\": "."
        }
    },
    "require": {
        "php": "^7.2||^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7",
        "shopware/shopware": "^5.6",
        "solutiondrive/sd-test-environment-shopware": "0.3"
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
